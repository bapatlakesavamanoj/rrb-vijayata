{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["data/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/live-notifications", "dest": "/api/live-notifications.js" },
    { "src": "/api/notifications",       "dest": "/api/notifications.js" },
    { "src": "/api/subscribe-alert",     "dest": "/api/subscribe-alert.js" },
    { "src": "/api/send-custom-alert",   "dest": "/api/send-custom-alert.js" },
    { "src": "/api/save-smtp-config",    "dest": "/api/save-smtp-config.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
